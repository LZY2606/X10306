; 局部源改动：只改一个直接来源（把 c_hi 上界从 1 改到 4）。
; 该改动只应使依赖 c_lo/c_hi 的 core 结论过期；check#1 的模型、
; 数组默认值与不支持理论诊断不受影响。
(set-logic QF_LIA)
< success
(set-option :produce-models true)
< success
%unit x m
%unit y m
(declare-const x Int)
< success
(declare-const y Int)
< success
(assert (! (>= x -3) :named a_x_floor))
< success
(assert (! (<= x 3) :named a_x_ceil))
< success
(check-sat)
$ sat
(get-model)
@ (
  (define-fun x () Int 1)
  (define-fun y () Int 2)
)
(push 1)
< success
(assert (! (>= x 2) :named c_lo))
< success
(assert (! (<= x 4) :named c_hi))
< success
(check-sat)
$ sat
(get-model)
@ (
  (define-fun x () Int 2)
  (define-fun y () Int 0)
)
(pop 1)
< success
